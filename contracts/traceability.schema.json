{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TraceabilityMatrix",
  "type": "object",
  "required": ["run_id", "links"],
  "properties": {
    "run_id": { "type": "string" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion_id", "locations", "evidence_tier"],
        "properties": {
          "criterion_id": { "type": "string" },
          "locations": { "type": "array", "items": { "type": "string" } },
          "evidence_tier": { "enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"] }
        }
      }
    }
  }
}
