# Intent Attestation Gate — local dev defaults (never commit real secrets)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
DATABASE_URL=sqlite:///./attestation.db
MOCK_LLM=false
ARTIFACT_DIR=./artifacts

# Attestor read-only gate. Both are read at run time, not at import, so a
# process must export them for a run to start at all.
#
# ATTESTOR_CAPS is REQUIRED and fails closed: a run that was launched without a
# declaration of its capabilities is refused before any stage executes, and the
# refusal names this variable. All five grants, or the policy is incomplete;
# `edit` and `execute` are refused outright, so declaring them refuses the run.
ATTESTOR_CAPS=read, subagent, skill, workflow, llm_egress
#
# ATTESTOR_WORKSPACE is the directory a run verifies against. Unset means the
# default above, which is created and made read-only on first use. A path set
# here is never created: a typo refuses the run rather than attesting to a
# directory nobody chose. On Windows this is enforced with a directory ACL and on
# POSIX with mode 0555 — both a permission on one directory, which is why the
# emitted record names the mechanism `no_write_bit` rather than a read-only
# mount (M10's D6 bind mount is the control that has no such weakness).
ATTESTOR_WORKSPACE=./attestor_workspace
